# DailySignal Environment Configuration Template

# Google Analytics 4 (GA4) Measurement ID (e.g. G-XXXXXXXXXX)
# When left empty, GA4 remains completely uninitialized and events log safely to the browser console during development.
VITE_GA_MEASUREMENT_ID=

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
# When left empty, beautiful, labeled developer placeholders are rendered instead of live ad scripts.
VITE_ADSENSE_CLIENT_ID=

# AdSlot IDs (Optional specific unit IDs provided by your AdSense dashboard)
VITE_ADSENSE_HEADER_SLOT=0000000001
VITE_ADSENSE_ARTICLE_SLOT=0000000002
VITE_ADSENSE_SIDEBAR_SLOT=0000000003
VITE_ADSENSE_FOOTER_SLOT=0000000004
